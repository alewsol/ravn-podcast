# Server-only Resend key with Full access (Contacts and sending).
RESEND_API_KEY=
# Use the same verified sender as the existing hosted site.
RESEND_FROM_EMAIL=
RESEND_NOTIFY_EMAIL=budera.founders@gmail.com
# Optional: a Resend segment ID for newsletter broadcasts.
RESEND_SEGMENT_ID=
# Optional dedicated cookie-signing secret; defaults to a key derived from RESEND_API_KEY.
SUBSCRIBER_SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=https://www.budera.ai
